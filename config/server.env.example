# server.env — lab-server-side configuration. Copy to server.env and edit.

# Where monitor state (counters, cooldowns, logs) lives on the server.
SERVER_STATE_DIR="$HOME/.lidar-guardian-server"

# Where status.json lives on each Jetson (must match STATE_DIR on the nodes).
NODE_STATE_DIR="/var/lib/lidar-guardian"

DOWN_THRESHOLD=3            # consecutive failed pings => "node down" alert
HEARTBEAT_MAX_AGE=300       # seconds before a node's status.json counts as stale
ALERT_COOLDOWN_SECS=3600    # min gap between repeated identical alerts

# ---- Email (via msmtp; see config/msmtprc.example) --------------------------
MAIL_TO="sheng@example.edu,kieran@example.edu"
MAIL_FROM="lidar-guardian@labserver"

# ---- Slack (optional) -------------------------------------------------------
SLACK_WEBHOOK_URL=""

# ---- Daily morning brief ----------------------------------------------------
# Process pattern used to detect an active recorder on each node. Confirm this
# matches how you actually launch recording before trusting the "Recording"
# line in the brief.
RECORDER_PATTERN="ros2 bag record"

# ---- Recording (driven by a DIFFERENT repo on the same host) ---------------
# Recording runs on the lab server, not on the nodes: record_day.sh starts
# record_supervisor.py here, and it spawns one local recorder per node and
# subscribes over the network. Nothing records on a Jetson.
#
# We read that system's own config rather than restating its thresholds — a
# copied threshold is a threshold that goes stale. Leave these empty to turn
# the recording probes off; they will report "not readable" rather than guess.
RECORDING_SCHEDULE_ENV="$HOME/lidar_social_recognition_deploy/config/recording_schedule.env"
RECORDING_DATA_DIR="$HOME/lidar_social_recognition_deploy/data"

# The units record_day.sh is driven by, checked by the monitor and the bot.
RECORD_START_TIMER="lidar-record-start.timer"

# Alert when recording should be running and is not. Set to 0 to disable.
# This exists because the failure it catches is invisible: a start timer that
# is `enabled` on disk but inactive fires nothing, reports no error, and looks
# exactly like a day with no recording scheduled.
RECORDING_ALERTS=1

# How long after the window opens before a missing session counts as a fault.
# The start timer also fires hourly inside the window so a reboot resumes the
# day, so a short gap is normal and alerting on it would be noise.
RECORDING_GRACE_SECS=900

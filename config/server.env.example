# server.env — lab-server-side configuration. Copy to server.env and edit.

# Where monitor state (counters, cooldowns, logs) lives on the server.
SERVER_STATE_DIR="$HOME/.lidar-guardian-server"

# Where status.json lives on each Jetson (must match STATE_DIR on the nodes).
NODE_STATE_DIR="/var/lib/lidar-guardian"

DOWN_THRESHOLD=3            # consecutive failed pings => "node down" alert
HEARTBEAT_MAX_AGE=300       # seconds before a node's status.json counts as stale
ALERT_COOLDOWN_SECS=3600    # min gap between repeated identical alerts

# ---- Email (via msmtp; see config/msmtprc.example) --------------------------
MAIL_TO="sheng@example.edu,kieran@example.edu"
MAIL_FROM="lidar-guardian@labserver"

# ---- Slack (optional) -------------------------------------------------------
SLACK_WEBHOOK_URL=""

# guardian.env — per-Jetson configuration. Copy to guardian.env and edit.

NODE_NAME="node1"
JETSON_USER="jetson"                 # the login user that runs the pipeline

# ---- LiDAR ------------------------------------------------------------------
# MID-360 IP on the Jetson's wired interface. Check your Livox config
# (default is 192.168.1.1XX where XX = last two digits of the serial number).
LIDAR_IP="192.168.1.112"

# ---- Power switch backend ---------------------------------------------------
# Which kind of USB switch Kieran installed. One of: usbrelay | uhubctl | gpio | cmd
# Identify it first:  lsusb ; sudo usbrelay ; sudo uhubctl
POWER_BACKEND="usbrelay"
USBRELAY_ID="HURTM_1"                # from `sudo usbrelay` output, e.g. HURTM_1
# UHUBCTL_LOCATION="2-1"             # for POWER_BACKEND=uhubctl
# UHUBCTL_PORT="4"
# GPIO_CHIP="gpiochip0"              # for POWER_BACKEND=gpio
# GPIO_LINE="12"
# GPIO_ON_VALUE=1
# POWER_ON_CMD=""                    # for POWER_BACKEND=cmd — any shell command
# POWER_OFF_CMD=""

# ---- Boot sequencing --------------------------------------------------------
MIN_UPTIME_SECS=45          # never touch LiDAR power before this uptime
STABLE_LOAD_MAX=2.0         # wait until 1-min load average drops below this
STABLE_LOAD_TRIES=12        # ... checking every 10 s, at most this many times
NETWORK_WAIT_TRIES=30       # wait for default gateway, 5 s per try
PRE_LIDAR_DELAY_SECS=10     # extra settle time before LiDAR power-on
LIDAR_BOOT_TIMEOUT_SECS=120 # how long to wait for LiDAR ping after power-on
ENSURE_TAILSCALE=1          # try `tailscale up` at boot if not connected

# Optional: auto-start the pipeline after the LiDAR is up (runs as JETSON_USER).
# Example:
# AUTO_START_CMD="cd /home/jetson/lidar_ws && python3 pipeline/00_start_driver_rosbridge/launcher.py --start --node node1"
AUTO_START_CMD=""

# ---- Watchdog ---------------------------------------------------------------
FAIL_THRESHOLD=3            # consecutive failed checks before power-cycling
MAX_POWER_CYCLES=3          # max auto power cycles per window, then give up
CYCLE_WINDOW_SECS=3600      # the window for the cycle budget (1 h)
POWER_CYCLE_OFF_SECS=10     # off-time during a cycle
POST_CYCLE_WAIT_SECS=45     # wait after a cycle before re-checking
DISK_WARN_PCT=85            # warn when / usage exceeds this
TEMP_WARN_C=85              # warn when CPU temp exceeds this
ALERT_COOLDOWN_SECS=3600    # min gap between repeated identical alerts

# ---- Optional ROS data-flow check (ping alone can miss a hung driver) -------
ROS_CHECK=0                 # set 1 to verify messages are actually publishing
ROS_SETUP="/home/jetson/lidar_ws/install/setup.bash"
ROS_TOPIC="/livox/lidar"
ROS_CHECK_TIMEOUT=10

# ---- Optional node-side Slack alert (email is sent by the lab server) -------
SLACK_WEBHOOK_URL=""
